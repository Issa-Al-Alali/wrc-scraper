# Mongo
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_URI=mongodb://admin:changeme@localhost:27017
MONGO_DB_NAME=wrc_landing
MONGO_TRANSFORMED_DB_NAME=wrc_transformed
MONGO_RAW_COLLECTION=cases_raw
MONGO_TRANSFORMED_COLLECTION=cases_transformed

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme123
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_RAW_BUCKET=wrc-landing-docs
MINIO_TRANSFORMED_BUCKET=wrc-transformed-docs

# Scraper behavior
WRC_BASE_URL=https://www.workplacerelations.ie/en/cases/
PARTITION_SIZE=monthly
CONCURRENT_REQUESTS=8
DOWNLOAD_DELAY=0.5
AUTOTHROTTLE_ENABLED=true
AUTOTHROTTLE_TARGET_CONCURRENCY=4
RETRY_TIMES=3
USER_AGENT=wrc-research-scraper (+contact-email@example.com)

# Bodies to scrape (comma separated)
WRC_BODIES=Employment Appeals Tribunal,Equality Tribunal,Labour Court,Workplace Relations Commission

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs